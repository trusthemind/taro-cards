# ── AI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe ────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints this.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids of two recurring prices on the same product.
# The app maps a price id back to a plan name by comparing against these, so
# the dev server and the test scripts must be started with the same values.
# `pnpm test:clock --bootstrap-prices` creates a pair and prints them.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Stripe no-code customer portal login link (Settings → Billing → Customer
# portal → Login link). Email-based, so subscribers who lost the visitor cookie
# can still manage or cancel. Optional; /pricing shows the link when set.
NEXT_PUBLIC_STRIPE_PORTAL_LOGIN_URL=

# `pnpm test:clock` additionally needs STRIPE_SECRET_KEY to be a real sandbox
# key — test clocks do not exist for placeholder keys, and the script refuses
# to run against sk_live_.

# Free-trial days for a first subscription; 0 turns the trial off.
STRIPE_TRIAL_DAYS=7

# ── Email (magic-link sign-in, daily reminders) ──────────────────────────
# https://resend.com → API keys. Without it, dev prints emails to the console.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=Містичне Таро <hello@example.com>

# ── Ops ──────────────────────────────────────────────────────────────────
# Bearer token for GET /api/admin/stats. Unset = endpoint closed.
ADMIN_TOKEN=
# Vercel Cron sends this as a bearer token to /api/cron/daily.
CRON_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
# Absolute origin used to build Stripe return URLs. Optional on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs the anonymous visitor cookie. Any long random string.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Persistence (optional locally, REQUIRED in production) ────────────────
# Without these, subscriptions live in process memory and are lost on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
