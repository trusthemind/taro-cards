# ── AI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe ────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints this.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids of two recurring prices on the same product.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ── App ───────────────────────────────────────────────────────────────────
# Absolute origin used to build Stripe return URLs. Optional on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs the anonymous visitor cookie. Any long random string.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Persistence (optional locally, REQUIRED in production) ────────────────
# Without these, subscriptions live in process memory and are lost on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
